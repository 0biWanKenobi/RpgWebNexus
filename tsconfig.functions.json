{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "strict": true,
    "skipLibCheck": true,
    "types": [],
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  "include": ["functions/**/*.ts", "functions/types.d.ts"]
}
